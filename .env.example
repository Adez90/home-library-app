# Copy to .env (never commit .env) and fill in real values before running
# `docker compose up` for production. Generate strong values with e.g.:
#   openssl rand -hex 32

POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-value

# Recommended for a server exposed to the internet: without this, anyone who finds your
# domain can register and create their own household. Set it to any password and share it
# only with people you want to be ABLE to create a new household — your wife joining YOURS
# still only needs the household invite code, not this.
REGISTRATION_SECRET=replace-with-another-random-value

# Optional. Leave blank to skip error reporting entirely — nothing else changes if you do.
# Get a DSN by creating a project in Sentry (sentry.io or self-hosted): one for the backend
# (Node/Fastify platform), one for the web app (React platform) if you want both.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Optional. Backend log verbosity: fatal, error, warn, info (default), debug, trace, or
# silent. Only affects what's written to stdout/docker logs — errors are always reported
# to Sentry above regardless of this setting.
LOG_LEVEL=info

# Only needed if deploying with docker-compose.shared-proxy.yml (running alongside another
# stack that already has its own reverse proxy on the server — see that file's own comments).
# Leave unset otherwise.
SHARED_PROXY_NETWORK=
