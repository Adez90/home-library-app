# Copy to .env (never commit .env) and fill in real values before running
# `docker compose up` for production. Generate strong values with e.g.:
#   openssl rand -hex 32

POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-value

# Recommended for a server exposed to the internet: without this, anyone who finds your
# domain can register and create their own household. Set it to any password and share it
# only with people you want to be ABLE to create a new household — your wife joining YOURS
# still only needs the household invite code, not this.
REGISTRATION_SECRET=replace-with-another-random-value
