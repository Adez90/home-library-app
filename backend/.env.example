DATABASE_URL=postgresql://library:library@localhost:5432/library
JWT_SECRET=change-me-in-production
PORT=3000
NODE_ENV=development

# Optional. When set, registering a NEW household (i.e. without an invite code) requires
# a matching `registrationSecret` in the request — stops strangers from creating accounts
# on a server exposed to the internet. Joining an existing household by invite code is
# never affected by this. Leave unset for open registration (fine for local dev).
# REGISTRATION_SECRET=
